[mysqld]

# Disables binary logging — reduces disk writes by 75-90%.
# Safe for single-server setups that don't need replication.
skip-log-bin

# Set to ~50% of total RAM
innodb_buffer_pool_size = 8G
innodb_io_capacity = 200
innodb_io_capacity_max = 1000
innodb_use_fdatasync = ON
innodb_buffer_pool_instances = 4
innodb_log_buffer_size = 64M

# Max age of binary logs - 5 days to prevent binary log pileups
binlog_expire_logs_seconds = 432000

# Optionally:
# Prevent SQL Deadlocks as much as possible
transaction_isolation="READ-COMMITTED"

# Additional (helpful with playerbots writes)
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2
innodb_log_file_size = 512M
#max_connections = # 151, 200 or 500

# If you see many slow queries
slow_query_log = 0
long_query_time = 2

# SSD optimizations
performance_schema = OFF
innodb_file_per_table = 1
innodb_flush_neighbors = 0
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_adaptive_flushing = ON
innodb_doublewrite = ON
